generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model cadastros {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha     Int
  createdAt DateTime @default(now())
}
